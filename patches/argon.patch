+// writeUpstreamError 写结构化 502（OpenAI 两条路的未开流分支用）。
+func writeUpstreamError(w http.ResponseWriter, err error, res *StreamResult) {
+	writeJSON(w, 502, map[string]interface{}{"error": upstreamErrorJSON(err, res)})
