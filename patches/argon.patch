+// 先认按类型/哨兵错误能钉死的几种（超时、出错话术、空抽取），再认
+// 「no content frame」这个错误串特征（单轮/多轮两条链、HTTP 层和解析层都产出
+// 同一句），剩下按错误串里的上游状态码和兜底归。
+func upstreamReason(err error) string {
+	var se *StallError
